{
  "manifest_version": 3,
  "name": "Paste Pal",
  "version": "1.3.0",
  "description": "Your job-application details in a side panel: click to copy, right-click to fill fields or attach your resume.",
  "permissions": ["storage", "sidePanel", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Paste Pal",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
